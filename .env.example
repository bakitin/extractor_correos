# Copia este archivo como .env y ajusta los valores.
# Formato: CLAVE=valor, una por línea. Los comentarios van en su propia línea.

IMAP_HOST=
IMAP_PUERTO=

# Carpeta local donde se guarda el backup
DESTINO=C:\Respaldos\correos

# Archivo CSV con las cuentas (relativo a la carpeta desde donde ejecutas main.py, o ruta absoluta)
CUENTAS_CSV=cuentas.csv

# Guardar también los adjuntos sueltos en la carpeta Adjuntos/ de cada correo: si / no
# El .eml siempre se guarda completo, con sus adjuntos adentro.
EXTRAER_ADJUNTOS=si
