# Copia este archivo como .env y ajusta los valores.
# Formato: CLAVE=valor, una por línea. Los comentarios van en su propia línea.

IMAP_HOST=imap.mail.ovh.ca
IMAP_PUERTO=993

# Carpeta local donde se guarda el backup
DESTINO=C:\Respaldos\correos

# Archivo CSV con las cuentas (relativo a la carpeta de este .env, o ruta absoluta)
CUENTAS_CSV=cuentas.csv

# Bandejas a respaldar: * para todas, o una lista separada por comas
# Ejemplo: CARPETAS=INBOX,Sent,Archivo
CARPETAS=*

# Extraer adjuntos y texto legible además del .eml: si / no
EXTRAER_ADJUNTOS=si
